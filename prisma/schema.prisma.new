// Prisma schema — SadivaCloset API — english code, portuguese messages only for user
// All table/column/class/endpoint names in English; only user-facing messages stay in Portuguese

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────

enum Role {
  BUYER  @map("comprador")
  ADMIN  @map("admin")
}

enum Category {
  SUITS   @map("fatos")
  SHIRTS  @map("camisas")
  DRESSES @map("vestidos")
  OTHERS  @map("outros")
}

enum ProductCondition {
  NEW        @map("novo")
  PRE_OWNED  @map("semi_novo")
}

enum OrderStatus {
  AWAITING_PAYMENT @map("aguardando_pagamento")
  PAID             @map("pago")
  PREPARING        @map("em_preparacao")
  SHIPPING         @map("em_entrega")
  COMPLETED        @map("concluido")
  CANCELLED        @map("cancelado")
}

enum DeliveryType {
  HOME_DELIVERY @map("domicilio")
  STORE_PICKUP  @map("levantamento_loja")
}

enum DeliveryStatus {
  SCHEDULED   @map("agendada")
  ON_THE_WAY  @map("a_caminho")
  DELIVERED   @map("entregue")
  FAILED      @map("falhada")
  CANCELLED   @map("cancelada")
}

enum PaymentMethod {
  MULTICAIXA_EXPRESS   @map("multicaixa_express")
  MULTICAIXA_REFERENCE @map("referencia_multicaixa")
  BANK_TRANSFER        @map("transferencia")
  CASH_ON_DELIVERY     @map("pagamento_entrega")
  CARD                 @map("cartao")
}

enum PaymentStatus {
  PENDING    @map("pendente")
  PROCESSING @map("processando")
  PAID       @map("pago")
  FAILED     @map("falhado")
  REFUNDED   @map("reembolsado")
}

// ── User ───────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(BUYER)
  createdAt    DateTime @default(now()) @map("created_at")
  isActive     Boolean  @default(true) @map("is_active")

  favorites     Favorite[]
  cartItems     CartItem[]
  notifications Notification[]
  addresses     Address[]
  orders        Order[]
  auditLogs     AuditLog[] @relation("AdminLogs")

  @@map("users")
}

// ── Product ──────────────────────────────────

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  image       String
  name        String
  description String           @db.Text
  category    Category
  size        String
  condition   ProductCondition
  stock       Int
  price       Int
  discount    Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at")

  favorites Favorite[]
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([category])
  @@index([condition])
  @@map("products")
}

// ── DeliveryZone ─────────────────────────

model DeliveryZone {
  id           String @id @default(uuid()) @db.Uuid
  neighborhood String @unique
  price        Int

  @@map("delivery_zones")
}

// ── Favorite ────────────────────────────────

model Favorite {
  buyerId   String   @map("buyer_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  buyer   User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([buyerId, productId])
  @@map("favorites")
}

// ── CartItem ────────────────────────────

model CartItem {
  id        String @id @default(uuid()) @db.Uuid
  buyerId   String @map("buyer_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity  Int    @default(1)

  buyer   User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buyerId, productId])
  @@map("cart_items")
}

// ── Notification ─────────────────────────

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  buyerId   String   @map("buyer_id") @db.Uuid
  title     String
  description String @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  isRead    Boolean  @default(false) @map("is_read")

  buyer User @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId, isRead])
  @@map("notifications")
}

// ── Address ─────────────────────────────────

model Address {
  id          String  @id @default(uuid()) @db.Uuid
  buyerId     String  @map("buyer_id") @db.Uuid
  label       String
  province    String
  municipality String
  neighborhood String
  street      String
  reference   String? @db.Text
  latitude    Float?  @db.DoublePrecision
  longitude   Float?  @db.DoublePrecision
  isDefault   Boolean @default(false) @map("is_default")

  buyer         User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  orderDeliveries Delivery[]

  @@index([buyerId])
  @@map("addresses")
}

// ── Order ─────────────────────────────────────

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  buyerId     String      @map("buyer_id") @db.Uuid
  subtotal    Int
  deliveryFee Int         @map("delivery_fee")
  total       Int
  status      OrderStatus @default(AWAITING_PAYMENT)
  createdAt   DateTime    @default(now()) @map("created_at")

  buyer    User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  delivery Delivery?
  payment  Payment?

  @@index([buyerId, status])
  @@map("orders")
}

// ── OrderItem ─────────────────────────────

model OrderItem {
  id          String @id @default(uuid()) @db.Uuid
  orderId     String @map("order_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid
  productName String @map("product_name")
  unitPrice   Int    @map("unit_price")
  discount    Int
  quantity    Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

// ── Delivery ───────────────────────────

model Delivery {
  id            String         @id @default(uuid()) @db.Uuid
  orderId       String         @unique @map("order_id") @db.Uuid
  type          DeliveryType
  addressId     String?        @map("address_id") @db.Uuid
  scheduledDate DateTime       @map("scheduled_date") @db.Date
  timeWindow    String         @map("time_window")
  status        DeliveryStatus @default(SCHEDULED)
  deliveryFee   Int            @map("delivery_fee")
  instructions  String?        @db.Text

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  address Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  @@map("deliveries")
}

// ── Payment ────────────────────────────────

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @unique @map("order_id") @db.Uuid
  method            PaymentMethod
  amount            Int
  status            PaymentStatus @default(PENDING)
  externalReference String?       @map("external_reference")
  receiptUrl        String?       @map("receipt_url")
  providerTxId      String?       @map("provider_tx_id")
  bridpayIntentId   String?       @map("bridpay_intent_id")
  bridpayMerchantTxId String?     @map("bridpay_merchant_tx_id")
  providerDetails   Json?         @map("provider_details") @db.JsonB
  phoneNumber       String?       @map("phone_number")
  iban              String?       @map("iban")
  webhookProcessedAt DateTime?    @map("webhook_processed_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ── Wallet (internal ledger for entradas/saidas) ──────────
model WalletTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  amount      Int
  balanceBefore Int    @default(0) @map("balance_before")
  balanceAfter  Int    @default(0) @map("balance_after")
  status      String   @default("settled")
  referenceType String @map("reference_type")
  referenceId String @map("reference_id") @db.Uuid
  description String?
  orderId     String? @map("order_id") @db.Uuid
  paymentId   String? @map("payment_id") @db.Uuid
  bridpayTxId String? @map("bridpay_tx_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

// ── Payout (saída via KWIK) ─────────────────────────────────
model Payout {
  id          String        @id @default(uuid()) @db.Uuid
  amount      Int
  iban        String
  method      PaymentMethod @default(BANK_TRANSFER)
  status      PaymentStatus @default(PENDING)
  externalReference String? @map("external_reference")
  providerTxId String?      @map("provider_tx_id")
  description String?
  orderId     String?       @map("order_id") @db.Uuid
  paymentId   String?       @map("payment_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("payouts")
}

// ── StoreConfig ───────────────────────────

model StoreConfig {
  id           String @id @default("singleton")
  name         String @default("SadivaCloset")
  contactEmail String @map("contact_email")
  phone        String
  address      String @db.Text

  @@map("store_configs")
}

// ── AdminPreferences ───────────────

model AdminPreferences {
  id                 String         @id @default("singleton")
  notifyNewOrders    Boolean        @default(true) @map("notify_new_orders")
  notifyLowStock     Boolean        @default(true) @map("notify_low_stock")
  notifyNewMessages  Boolean        @default(true) @map("notify_new_messages")
  defaultDeliveryFee Int            @default(3000) @map("default_delivery_fee")
  activePaymentMethods PaymentMethod[] @map("active_payment_methods")

  @@map("admin_preferences")
}

// ── AuditLog ────────────────────────────

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id")
  details   Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  admin User @relation("AdminLogs", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([entity, entityId])
  @@map("audit_logs")
}
