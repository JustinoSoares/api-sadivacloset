# =============================================================================
# SadivaCloset API — Template de Variáveis de Ambiente (.env.example)
# =============================================================================
# 1. Copie: cp .env.example .env
# 2. Preencha os valores obrigatórios (marcados com ★)
# 3. Gere secrets: openssl rand -base64 32
# 4. Nunca commitar .env (está no .gitignore)
# 5. A aplicação NÃO sobe se faltar variável obrigatória — veja erro no terminal
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1) APLICAÇÃO
# ─────────────────────────────────────────────────────────────────────────────
# Ambiente: development | production | test
NODE_ENV=development
# Porta exposta no host (Docker mapeia ${PORT}:${PORT}, default 3001)
PORT=3001

# ─────────────────────────────────────────────────────────────────────────────
# 2) BASE DE DADOS — PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
# Usado pelo docker-compose para criar o container postgres
POSTGRES_USER=sadiva
POSTGRES_PASSWORD=sadiva123
POSTGRES_DB=sadivacloset

# ★ OBRIGATÓRIA — URL de conexão Prisma
# Escolha UMA conforme onde a API vai correr:
# Docker (rede interna):  postgresql://sadiva:sadiva123@postgres:5432/sadivacloset?schema=public
# Host local (fora do Docker): postgresql://sadiva:sadiva123@localhost:5435/sadivacloset?schema=public
# Neon (produção):        postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://sadiva:sadiva123@postgres:5432/sadivacloset?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# 3) CACHE / FILA — Redis
# ─────────────────────────────────────────────────────────────────────────────
# ★ OBRIGATÓRIA
# Docker (rede interna): redis://redis:6379
# Host local:            redis://localhost:6381
REDIS_URL="redis://redis:6379"

# ─────────────────────────────────────────────────────────────────────────────
# 4) AUTENTICAÇÃO — JWT
# ─────────────────────────────────────────────────────────────────────────────
# ★ OBRIGATÓRIAS — mínimo 16 chars (32+ recomendado, obrigatório em produção)
# Gere com: openssl rand -base64 32
JWT_SECRET="change-me-super-secret-jwt-32chars-min"
JWT_REFRESH_SECRET="change-me-super-secret-refresh-32chars-min"
# Formato: número + unidade (s|m|h|d) — ex: 15m, 1h, 7d
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─────────────────────────────────────────────────────────────────────────────
# 5) BRIDPAY — Proxy opcional
# ─────────────────────────────────────────────────────────────────────────────
# Se preencher, a API usa BridPay como gateway; se vazio, chama AppPay/E-Kwanza direto.
BRIDPAY_BASE_URL="http://localhost:3000"
BRIDPAY_API_KEY=""
BRIDPAY_ENVIRONMENT="sandbox"

# ─────────────────────────────────────────────────────────────────────────────
# 6) APPPAY (GPO — Multicaixa Express / GPR — Referência)
# ─────────────────────────────────────────────────────────────────────────────
# Copiar de ../api-bridpay/.env — deixe vazio se não usar AppPay
APPYPAY_ENVIRONMENT="sandbox"
APPYPAY_AUTH_URL="https://login.microsoftonline.com/{tenant}/oauth2/token"
APPYPAY_TENANT="appypaydev.onmicrosoft.com"
APPYPAY_CLIENT_ID=""
APPYPAY_CLIENT_SECRET=""
APPYPAY_RESOURCE="bee57785-7a19-4f1c-9c8d-aa03f2f0e333"
APPYPAY_API_BASE_URL="https://gwy-api.appypay.co.ao"
APPYPAY_MERCHANT_IDENTIFIER=""
APPYPAY_OPTIONS_API_KEY=""
APPYPAY_PAYMENT_METHOD_GPO="GPO_0d23d2b0-c19c-42ca-b423-38c150acac5e"
APPYPAY_PAYMENT_METHOD_REFERENCE="REF_8d9c9851-4d33-4d8d-82b5-3d3b4cea5d92"
APPYPAY_WEBHOOK_SECRET=""
APPYPAY_HTTP_TIMEOUT_MS="10000"

# ─────────────────────────────────────────────────────────────────────────────
# 7) E-KWANZA (KWiK — saque IBAN / Ticket)
# ─────────────────────────────────────────────────────────────────────────────
EKWANZA_API_BASE_URL="https://api.e-kwanza.co.ao"
EKWANZA_NOTIFICATION_TOKEN=""
EKWANZA_API_KEY=""
EKWANZA_MERCHANT_REGISTRATION_NUMBER=""
EKWANZA_HTTP_TIMEOUT_MS="10000"

# ─────────────────────────────────────────────────────────────────────────────
# 8) UPLOADS — Comprovativos
# ─────────────────────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
UPLOAD_MAX_SIZE_MB="5"

# ─────────────────────────────────────────────────────────────────────────────
# 9) WEBHOOKS & FILAS
# ─────────────────────────────────────────────────────────────────────────────
# ★ OBRIGATÓRIA em produção — HMAC para POST /api/v1/webhooks/pagamento/:gateway
# Header: x-signature = HMAC_SHA256(rawBody, PAYMENT_WEBHOOK_SECRET)
# Gere com: openssl rand -base64 32
PAYMENT_WEBHOOK_SECRET="change-me-webhook-secret-32chars"
# Opcionais por gateway (têm prioridade sobre o genérico se definidos):
# PAYMENT_WEBHOOK_SECRET_APPYPAY=""
# PAYMENT_WEBHOOK_SECRET_EKWANZA=""
# PAYMENT_WEBHOOK_SECRET_BRIDPAY=""
# PAYMENT_WEBHOOK_SECRET_GENERIC=""

# Aliases legados (compatibilidade):
# WEBHOOK_PAYMENT_SECRET=""
# WEBHOOK_SECRET=""

# Nome da fila BullMQ
PAYMENT_QUEUE_NAME="pagamento-confirmado"
