# App — PORT é a porta host (mapeada para 3000 dentro do container)
PORT=3001
NODE_ENV=development

# Database (docker-compose service: postgres)
POSTGRES_USER=sadiva
POSTGRES_PASSWORD=sadiva123
POSTGRES_DB=sadivacloset
# Dentro do Docker (rede sadiva-network):
DATABASE_URL="postgresql://sadiva:sadiva123@postgres:5432/sadivacloset?schema=public"
# Para uso local fora do Docker (prisma migrate/seed no host), use:
# DATABASE_URL="postgresql://sadiva:sadiva123@localhost:5435/sadivacloset?schema=public"

# Redis (docker-compose service: redis)
REDIS_URL="redis://redis:6379"
# Para uso local fora do Docker:
# REDIS_URL="redis://localhost:6381"

# Auth — gere com: openssl rand -base64 32
JWT_SECRET="change-me-super-secret-jwt-32chars-min"
JWT_REFRESH_SECRET="change-me-super-secret-refresh-32chars-min"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
