# App — PORT é a porta host (mapeada para 3000 dentro do container)
PORT=3001
NODE_ENV=development

# Database (docker-compose service: postgres)
POSTGRES_USER=sadiva
POSTGRES_PASSWORD=sadiva123
POSTGRES_DB=sadivacloset
# Dentro do Docker (rede sadiva-network):
DATABASE_URL="postgresql://sadiva:sadiva123@postgres:5432/sadivacloset?schema=public"
# Para uso local fora do Docker (prisma migrate/seed no host), use:
# DATABASE_URL="postgresql://sadiva:sadiva123@localhost:5435/sadivacloset?schema=public"

# Redis (docker-compose service: redis)
REDIS_URL="redis://redis:6379"
# Para uso local fora do Docker:
# REDIS_URL="redis://localhost:6381"

# Auth — gere com: openssl rand -base64 32
JWT_SECRET="change-me-super-secret-jwt-32chars-min"
JWT_REFRESH_SECRET="change-me-super-secret-refresh-32chars-min"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── BridPay (opcional – se usar proxy BridPay ao invés de direto) ───
# Se preferir chamar a BridPay como gateway, preencha. Senão deixe vazio e o serviço chama AppPay/E-Kwanza direto.
BRIDPAY_BASE_URL="http://localhost:3000"
BRIDPAY_API_KEY=""
BRIDPAY_ENVIRONMENT="sandbox"

# ─── AppPay (GPO – Multicaixa Express push / GPR – Referência) – COPiar de ../api-bridpay/.env ───
APPYPAY_ENVIRONMENT="sandbox"
APPYPAY_AUTH_URL="https://login.microsoftonline.com/{tenant}/oauth2/token"
APPYPAY_TENANT="appypaydev.onmicrosoft.com"
APPYPAY_CLIENT_ID=""
APPYPAY_CLIENT_SECRET=""
APPYPAY_RESOURCE="bee57785-7a19-4f1c-9c8d-aa03f2f0e333"
APPYPAY_API_BASE_URL="https://gwy-api.appypay.co.ao"
APPYPAY_MERCHANT_IDENTIFIER=""
APPYPAY_OPTIONS_API_KEY=""
APPYPAY_PAYMENT_METHOD_GPO="GPO_0d23d2b0-c19c-42ca-b423-38c150acac5e"
APPYPAY_PAYMENT_METHOD_REFERENCE="REF_8d9c9851-4d33-4d8d-82b5-3d3b4cea5d92"
APPYPAY_WEBHOOK_SECRET=""
APPYPAY_HTTP_TIMEOUT_MS="10000"

# ─── E-Kwanza (KWiK – saque IBAN / Ticket) – Copiar de ../api-bridpay/.env ───
EKWANZA_API_BASE_URL="https://api.e-kwanza.co.ao"
EKWANZA_NOTIFICATION_TOKEN=""
EKWANZA_API_KEY=""
EKWANZA_MERCHANT_REGISTRATION_NUMBER=""
EKWANZA_HTTP_TIMEOUT_MS="10000"

# Upload comprovativos
UPLOAD_DIR="./uploads"
UPLOAD_MAX_SIZE_MB="5"

# ─── Webhook genérico pagamento/:gateway (HMAC) ───
# Validação HMAC para POST /api/v1/webhooks/pagamento/:gateway (público)
# O gateway envia x-signature = HMAC_SHA256(rawBody, PAYMENT_WEBHOOK_SECRET)
PAYMENT_WEBHOOK_SECRET="change-me-webhook-secret-32chars"
# Opcional por gateway: PAYMENT_WEBHOOK_SECRET_APPYPAY, PAYMENT_WEBHOOK_SECRET_EKWANZA, etc.
PAYMENT_QUEUE_NAME="pagamento-confirmado"
