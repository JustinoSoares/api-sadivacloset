{
  "info": {
    "name": "SadivaCloset API - Fluxo Completo Postman",
    "_postman_id": "sadivacloset-fluxo-completo-v1",
    "description": "Fluxo completo para testar no Postman: Auth -> Catalogo -> Endereco -> Carrinho -> Checkout -> Pedido -> Pagamento (GPO/GPR/BANK) -> Webhook/Admin Validar. \nBaseUrl: http://localhost:3001/api/v1 (local) ou https://api-sadivacloset.himersus.com/api/v1 (staging). \nOrdem para clicar em Send: siga a numeracao 01 -> 26. Variaveis sao preenchidas automaticamente via Tests.\nPrefix global /api/v1 - exceto health (/health) que usa {{host}}/health.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Health - sem prefixo",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{host}}/health",
          "host": ["{{host}}"],
          "path": ["health"]
        },
        "description": "Health check publico sem /api/v1. Deve retornar {status:\"ok\", database:\"up\"}"
      }
    },
    {
      "name": "01 Auth - Register Buyer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Maria Silva\",\n  \"email\": \"maria.teste.{{$timestamp}}@teste.com\",\n  \"password\": \"StrongPass123\"\n}"
        },
        "description": "Cria BUYER. 409 se email já existe. Use {{$timestamp}} para email único. Salva email em variável."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if(pm.response.code===201){",
              "  const json=pm.response.json();",
              "  pm.environment.set('buyer_email', JSON.parse(pm.request.body.raw).email);",
              "  console.log('Buyer criado', json.data);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "01b Auth - Register Buyer FIXO (para login repetido)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Comprador Teste\",\n  \"email\": \"comprador@teste.com\",\n  \"password\": \"StrongPass123\"\n}"
        },
        "description": "Use este se quiser login fixo sem timestamp. Se 409 já existe, faça login direto."
      }
    },
    {
      "name": "02 Auth - Login Buyer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"comprador@teste.com\",\n  \"password\": \"StrongPass123\"\n}"
        },
        "description": "Se usou 01 com timestamp, troque email por {{buyer_email}}. Retorna access_token e refresh_token. Tests salvam automaticamente."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if(pm.response.code===200){",
              "  const json=pm.response.json();",
              "  pm.environment.set('access_token', json.access_token);",
              "  pm.environment.set('refresh_token', json.refresh_token);",
              "  console.log('access_token salvo');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "03 Auth - Login Admin (seed)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@sadivacloset.local\",\n  \"password\": \"Admin@123\"\n}"
        },
        "description": "Admin criado via prisma/seed.ts. Salva admin_access_token para validar pagamento."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if(pm.response.code===200){",
              "  const json=pm.response.json();",
              "  pm.environment.set('admin_access_token', json.access_token);",
              "  pm.environment.set('admin_refresh_token', json.refresh_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "04 Auth - Get Profile (JWT)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{baseUrl}}/profile", "host": ["{{baseUrl}}"], "path": ["profile"] }
      }
    },
    {
      "name": "04b Auth - Refresh Token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth","refresh"] },
        "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if(pm.response.code===200){",
              "  const json=pm.response.json();",
              "  pm.environment.set('access_token', json.access_token);",
              "  pm.environment.set('refresh_token', json.refresh_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "05 Catalogo - List Products (public)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products?page=1&limit=12",
          "host": ["{{baseUrl}}"],
          "path": ["products"],
          "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "12" }]
        },
        "description": "Paginado, filtrável. Query adicionais: q=Suit&category=SUITS,SHIRTS&size=M&condition=NEW&price_min=10000&price_max=50000&sort=price_asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if(pm.response.code===200){",
              "  const json=pm.response.json();",
              "  if(json.data && json.data.length>0){",
              "    pm.environment.set('productId', json.data[0].id);",
              "    pm.environment.set('productId2', json.data[1]?.id || json.data[0].id);",
              "    console.log('productId', json.data[0].id);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "06 Catalogo - Get Product Details",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products","{{productId}}"] }
      }
    },
    {
      "name": "07 Catalogo - List Categories",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
      }
    },
    {
      "name": "08 Catalogo - List Delivery Zones",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/delivery-zones", "host": ["{{baseUrl}}"], "path": ["delivery-zones"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if(pm.response.code===200){",
              "  const json=pm.response.json();",
              "  if(json.data && json.data.length>0){",
              "    pm.environment.set('deliveryZoneId', json.data[0].id);",
              "    console.log('deliveryZoneId', json.data[0].id, json.data[0].neighborhood, json.data[0].price);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "09 Address - Create (primeiro vira default)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/profile/addresses", "host": ["{{baseUrl}}"], "path": ["profile","addresses"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"label\": \"Home\",\n  \"province\": \"Luanda\",\n  \"municipality\": \"Talatona\",\n  \"neighborhood\": \"Talatona\",\n  \"street\": \"Rua da Samba 123\",\n  \"reference\": \"Perto do Kero Talatona\",\n  \"latitude\": -8.8368,\n  \"longitude\": 13.2344\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if(pm.response.code===201){",
              "  const json=pm.response.json();",
              "  pm.environment.set('addressId', json.data.id);",
              "  console.log('addressId', json.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "10 Address - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{baseUrl}}/profile/addresses", "host": ["{{baseUrl}}"], "path": ["profile","addresses"] }
      }
    },
    {
      "name": "11 Address - Set Default",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{baseUrl}}/profile/addresses/{{addressId}}/default", "host": ["{{baseUrl}}"], "path": ["profile","addresses","{{addressId}}","default"] }
      }
    },
    {
      "name": "12 Cart - Add Item (valida stock)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/cart/items", "host": ["{{baseUrl}}"], "path": ["cart","items"] },
        "body": { "mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if(pm.response.code===201){",
              "  pm.environment.set('cartItemId', pm.response.json().data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "12b Cart - Add Segundo Produto (opcional)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/cart/items", "host": ["{{baseUrl}}"], "path": ["cart","items"] },
        "body": { "mode": "raw", "raw": "{\n  \"productId\": \"{{productId2}}\",\n  \"quantity\": 2\n}" }
      }
    },
    {
      "name": "13 Cart - Get (com subtotal)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{baseUrl}}/cart", "host": ["{{baseUrl}}"], "path": ["cart"] }
      }
    },
    {
      "name": "14 Cart - Update Quantity",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/cart/items/{{cartItemId}}", "host": ["{{baseUrl}}"], "path": ["cart","items","{{cartItemId}}"] },
        "body": { "mode": "raw", "raw": "{\n  \"quantity\": 2\n}" }
      }
    },
    {
      "name": "15 Checkout - Create Order HOME_DELIVERY",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/checkout", "host": ["{{baseUrl}}"], "path": ["checkout"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"HOME_DELIVERY\",\n  \"scheduledDate\": \"2026-09-15\",\n  \"timeWindow\": \"09:00-12:00\",\n  \"addressId\": \"{{addressId}}\",\n  \"deliveryZoneId\": \"{{deliveryZoneId}}\"\n}"
        },
        "description": "Transacao: valida stock, decrementa, cria order+delivery, limpa cart. Throttle 10/min. Se STORE_PICKUP use sem addressId. scheduledDate >= hoje."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if(pm.response.code===201){",
              "  const json=pm.response.json();",
              "  pm.environment.set('orderId', json.data.id);",
              "  console.log('orderId', json.data.id, 'total', json.data.total);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "15b Checkout - Create Order STORE_PICKUP (frete 0)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/checkout", "host": ["{{baseUrl}}"], "path": ["checkout"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"STORE_PICKUP\",\n  \"scheduledDate\": \"2026-09-16\",\n  \"timeWindow\": \"14:00-17:00\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if(pm.response.code===201){ pm.environment.set('orderId', pm.response.json().data.id); }"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "16 Order - Get Detail",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{baseUrl}}/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["orders","{{orderId}}"] }
      }
    },
    {
      "name": "17 Order - List My Orders",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": {
          "raw": "{{baseUrl}}/profile/orders?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["profile","orders"],
          "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }]
        }
      }
    },
    {
      "name": "18 Payment - Init GPO Multicaixa Express (com telefone)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/payment/init", "host": ["{{baseUrl}}"], "path": ["orders","{{orderId}}","payment","init"] },
        "body": { "mode": "raw", "raw": "{\n  \"method\": \"gpo\",\n  \"phoneNumber\": \"923456789\",\n  \"description\": \"Pedido {{orderId}} - GPO\"\n}" },
        "description": "Aliases: gpo|MULTICAIXA_EXPRESS|multicaixa_express. Retorna externalReference 15 chars em PROCESSING."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if(pm.response.code===201){",
              "  const d=pm.response.json().data;",
              "  pm.environment.set('paymentId', d.id);",
              "  pm.environment.set('externalReference', d.externalReference);",
              "  console.log('paymentId', d.id, 'externalReference', d.externalReference);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "19 Payment - Init GPR Referencia (sem telefone)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/payment/init", "host": ["{{baseUrl}}"], "path": ["orders","{{orderId}}","payment","init"] },
        "body": { "mode": "raw", "raw": "{\n  \"method\": \"gpr\",\n  \"description\": \"Pedido {{orderId}} - GPR\"\n}" },
        "description": "Aliases: gpr|MULTICAIXA_REFERENCE|reference. providerDetails tem entity/reference/expirationDate para exibir."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if(pm.response.code===201){",
              "  const d=pm.response.json().data;",
              "  pm.environment.set('paymentId', d.id);",
              "  pm.environment.set('externalReference', d.externalReference);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "20 Payment - Init BANK_TRANSFER",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/payment/init", "host": ["{{baseUrl}}"], "path": ["orders","{{orderId}}","payment","init"] },
        "body": { "mode": "raw", "raw": "{\n  \"method\": \"BANK_TRANSFER\",\n  \"description\": \"Transferencia pedido {{orderId}}\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if(pm.response.code===201){",
              "  pm.environment.set('paymentId', pm.response.json().data.id);",
              "  pm.environment.set('externalReference', pm.response.json().data.externalReference);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "21 Payment - Get Status",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/payment", "host": ["{{baseUrl}}"], "path": ["orders","{{orderId}}","payment"] }
      }
    },
    {
      "name": "22 Payment - Upload Receipt (BANK_TRANSFER)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/payment/receipt", "host": ["{{baseUrl}}"], "path": ["orders","{{orderId}}","payment","receipt"] },
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "file", "type": "file", "src": [] }]
        },
        "description": "Para BANK_TRANSFER. Envia comprovativo (max 5MB). Se API estiver com storage local, arquivo salvo em /uploads. Alternativa JSON: {\"receiptUrl\":\"https://...\"} depende da config."
      }
    },
    {
      "name": "23 Webhook - Simular AppyPay SUCCESS (GPO/GPR mock)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-signature", "value": "" }
        ],
        "url": { "raw": "{{baseUrl}}/webhooks/appypay", "host": ["{{baseUrl}}"], "path": ["webhooks","appypay"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantTransactionId\": \"{{externalReference}}\",\n  \"operationStatus\": 1,\n  \"operationData\": {\n    \"referenceType\": \"GPO\",\n    \"amount\": 83500\n  }\n}"
        },
        "description": "Simula callback AppyPay sem HMAC (dev). Em prod precisa x-signature = HMAC_SHA256(rawBody, APPYPAY_WEBHOOK_SECRET). operationStatus 1=sucesso, 3=cancelado, 4=falhado. GPO usa referenceType GPO, GPR usa REF."
      }
    },
    {
      "name": "24 Webhook - Simular Generic SUCCESS",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-signature", "value": "" }
        ],
        "url": { "raw": "{{baseUrl}}/webhooks/payment/generic", "host": ["{{baseUrl}}"], "path": ["webhooks","payment","generic"] },
        "body": { "mode": "raw", "raw": "{\n  \"externalReference\": \"{{externalReference}}\",\n  \"status\": \"paid\"\n}" },
        "description": "Webhook generico idempotente. Se PAYMENT_WEBHOOK_SECRET configurado, gere HMAC: echo -n '{\"externalReference\":\"{{externalReference}}\",\"status\":\"paid\"}' | openssl dgst -sha256 -hmac $PAYMENT_WEBHOOK_SECRET . Sem secret aceita sem x-signature em dev."
      }
    },
    {
      "name": "25 Admin - Validar Pagamento Manual",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }],
        "url": { "raw": "{{baseUrl}}/admin/payments/{{paymentId}}/validar", "host": ["{{baseUrl}}"], "path": ["admin","payments","{{paymentId}}","validar"] },
        "description": "Alternativa ao webhook: admin valida e pedido vira PAID. Precisa admin_access_token."
      }
    },
    {
      "name": "26 Verificar - Order virou PAID",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{baseUrl}}/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["orders","{{orderId}}"] }
      }
    },
    {
      "name": "27 Wallet - Historico",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": {
          "raw": "{{baseUrl}}/wallet/history?page=1&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["wallet","history"],
          "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }]
        }
      }
    },
    {
      "name": "28 Cart - Remove Item",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{baseUrl}}/cart/items/{{cartItemId}}", "host": ["{{baseUrl}}"], "path": ["cart","items","{{cartItemId}}"] }
      }
    },
    {
      "name": "29 Order - Cancel (se nao estiver ON_THE_WAY)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/cancel", "host": ["{{baseUrl}}"], "path": ["orders","{{orderId}}","cancel"] }
      }
    },
    {
